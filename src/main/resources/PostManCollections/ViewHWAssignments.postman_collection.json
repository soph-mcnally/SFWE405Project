{
  "info": {
    "_postman_id": "52b54a34-8002-4214-9942-d79f47790186",
    "name": "ViewHWAssignments",
    "description": "1. Run GetToken (Body must have username & password)\n    \n    1. Copy given token\n        \n2. Change token variable in ViewAssignments\n    \n3. Run ViewAssignments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51743897",
    "_collection_link": "https://go.postman.co/collection/51743897-52b54a34-8002-4214-9942-d79f47790186?source=collection_link"
  },
  "item": [
    {
      "name": "GetToken",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const token = response.token || response.accessToken || response.access_token;",
              "if (token) {",
              "    pm.vault.set(\"bearer-token\", token);",
              "    console.log(\"Token saved to vault successfully\");",
              "} else {",
              "    console.log(\"Could not find token in response:\", JSON.stringify(response));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"testUser\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "ViewAssignments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "{{vault:bearer-token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/homework-assignment/ViewHWAssignmentByCourse/{{courseId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "homework-assignment",
            "ViewHWAssignmentByCourse",
            "{{courseId}}"
          ]
        }
      },
      "response": []
    }
  ]
}