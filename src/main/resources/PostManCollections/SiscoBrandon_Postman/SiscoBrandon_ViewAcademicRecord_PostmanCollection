    {
      "name": "Academic",
      "item": [
        {
          "name": "Academic Record Request Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Academic record success returns 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Academic record response is a page response object\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData).to.be.an(\"object\");\r",
                  "    pm.expect(jsonData).to.have.property(\"content\");\r",
                  "    pm.expect(jsonData).to.have.property(\"currentPage\");\r",
                  "    pm.expect(jsonData).to.have.property(\"totalPages\");\r",
                  "    pm.expect(jsonData).to.have.property(\"totalElements\");\r",
                  "    pm.expect(jsonData).to.have.property(\"first\");\r",
                  "    pm.expect(jsonData).to.have.property(\"last\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Academic record contains at least one course\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData.content).to.be.an(\"array\");\r",
                  "    pm.expect(jsonData.content.length).to.be.above(0);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get(\"studentToken\")) {\r",
                  "    throw new Error(\"studentToken not set. Run student login first.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
