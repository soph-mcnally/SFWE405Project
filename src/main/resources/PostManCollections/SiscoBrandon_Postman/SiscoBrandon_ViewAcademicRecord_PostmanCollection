        {
          "name": "Login Success (student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Student login returns 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Student login response contains token\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.token).to.exist;\r",
                  "    pm.expect(jsonData.role).to.eql(\"STUDENT\");\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.collectionVariables.set(\"studentToken\", jsonData.token);"
                ],
