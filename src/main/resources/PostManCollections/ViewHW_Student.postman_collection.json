{
  "info": {
    "_postman_id": "1d606ae0-dec1-40f5-8fe6-8ef8589e4042",
    "name": "ViewHW-Student",
    "description": "1. Run GetToken (Body must have username & password)\n    \n    1. Copy given token\n        \n2. Change token variable in ViewAssignments\n    \n3. Run ViewAssignments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "51743897",
    "_collection_link": "https://go.postman.co/collection/51743897-1d606ae0-dec1-40f5-8fe6-8ef8589e4042?source=collection_link"
  },
  "item": [
    {
      "name": "GetToken_S",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const token = response.token || response.accessToken || response.access_token;",
              "if (token) {",
              "    pm.collectionVariables.set(\"token\", token);",
              "    console.log(\"Token saved to environment successfully\");",
              "} else {",
              "    console.log(\"Could not find token in response:\", JSON.stringify(response));",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"testUser\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "ViewHW_S",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/homework-assignment/studentViewHWByCourse/{{courseId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "homework-assignment",
            "studentViewHWByCourse",
            "{{courseId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "courseId",
      "value": "1",
      "type": "default"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}